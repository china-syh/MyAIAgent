# =============================================================================
# AI 漫剧 Agent - 环境变量配置
# =============================================================================
# 复制此文件为 .env 并根据实际环境修改配置
# cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# 应用配置
# ---------------------------------------------------------------------------
APP_NAME="AI 漫剧 Agent"
APP_VERSION="2.0.0"
ENV=development                    # 运行环境: development / staging / production
DEBUG=true                         # 调试模式: true / false

# ---------------------------------------------------------------------------
# 安全配置
# ---------------------------------------------------------------------------
# 请在生产环境中更换为强随机密钥，可使用: openssl rand -hex 32
SECRET_KEY=manga-agent-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30     # 访问令牌过期时间（分钟）
REFRESH_TOKEN_EXPIRE_DAYS=7        # 刷新令牌过期时间（天）
ALGORITHM=HS256                    # JWT 签名算法
ALLOWED_HOSTS=["*"]                # 允许的主机列表

# ---------------------------------------------------------------------------
# 数据库配置（PostgreSQL + asyncpg）
# ---------------------------------------------------------------------------
# 格式: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://manga:manga123@localhost:5432/manga_agent
DATABASE_POOL_SIZE=10              # 连接池大小
DATABASE_MAX_OVERFLOW=20           # 连接池最大溢出数

# ---------------------------------------------------------------------------
# Redis 配置
# ---------------------------------------------------------------------------
# 格式: redis://<host>:<port>/<db>
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Milvus 向量数据库配置
# ---------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_ALIAS=default

# ---------------------------------------------------------------------------
# LLM 配置（OpenAI 兼容 API）
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-api-key     # 替换为实际的 API Key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini              # 对话模型
EMBEDDING_MODEL=text-embedding-3-small  # 向量嵌入模型

# ---------------------------------------------------------------------------
# 向量配置
# ---------------------------------------------------------------------------
EMBEDDING_DIM=1536                 # 向量维度（需与嵌入模型匹配）

# ---------------------------------------------------------------------------
# 文件上传配置
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads                 # 文件上传目录
MAX_UPLOAD_SIZE=10485760           # 单文件最大字节数（默认 10MB = 10 * 1024 * 1024）
ALLOWED_EXTENSIONS=["jpg","jpeg","png","gif","webp","pdf"]  # 允许的文件扩展名

# ---------------------------------------------------------------------------
# CORS 配置
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://localhost:80"]

# ---------------------------------------------------------------------------
# Docker Compose 部署专用
# ---------------------------------------------------------------------------
# 以下变量仅在 docker-compose 环境中使用（非必需）
# COMPOSE_PROJECT_NAME=ai-manga-agent
# POSTGRES_USER=manga
# POSTGRES_PASSWORD=manga123
# POSTGRES_DB=manga_agent
# ---------------------------------------------------------------------------
# DeepSeek 配置（用于图片提示词生成、视频规划等）
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key  # 替换为实际的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# 图片生成配置
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=pollinations           # pollinations / huggingface
IMAGE_API_URL=https://image.pollinations.ai/prompt
IMAGE_MODEL=flux
IMAGE_TIMEOUT_SECONDS=90
IMAGE_RETRIES=3
HF_TOKEN=                             # 使用 huggingface 时需要设置
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
